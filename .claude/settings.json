{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash",
      "PowerShell"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(rm -rf*)",
      "Bash(gh pr *)",
      "Bash(gh api*)",
      "PowerShell(& \"$env:USERPROFILE\\.fly\\bin\\flyctl.exe\" deploy*)",
      "PowerShell(& \"$env:USERPROFILE\\.fly\\bin\\flyctl.exe\" ssh *)",
      "PowerShell(& \"$env:USERPROFILE\\.fly\\bin\\flyctl.exe\" secrets *)",
      "PowerShell(& \"$env:USERPROFILE\\.fly\\bin\\flyctl.exe\" machine *)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(Remove-Item -Recurse -Force*)",
      "PowerShell(gh pr *)",
      "PowerShell(gh api*)"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
